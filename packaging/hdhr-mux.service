[Unit]
Description=HDHomeRun multiplexer
Documentation=https://github.com/hdhrgit/hdhr-mux-demux
After=network-online.target
Wants=network-online.target

[Service]
# systemd makes a private user for the service and owns its state directory
# (/var/lib/hdhr-mux): nothing to create or clean up. The state directory is the
# working directory, which is where the lineup, guide and saved settings go. A
# config file is optional: /etc/hdhr-mux/config.json is read if somebody makes one.
DynamicUser=yes
StateDirectory=hdhr-mux
WorkingDirectory=/var/lib/hdhr-mux
ExecStart=/usr/bin/hdhr-mux
# The settings page's Restart button restarts the process in place; this brings it
# back after a crash.
Restart=always
RestartSec=3
# ports 80, 5004 and 65001 (UDP discovery)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
