{
  "device_id": "auto",
  "discoverable": true,
  "friendly_name": "HDHomeRun Mux",
  "virtual_tuners": 0,
  "http_listen": ":80",
  "stream_listen": ":5004",
  "control_listen": ":65001",
  "state_dir": "/var/lib/hdhr-mux",

  "upstream": {
    "discover": true,
    "devices": [],
    "allow": [],
    "tuners": [],
    "exclude": [],
    "mode": "http",
    "mask": true
  },

  "lineup": {
    "channel_map": "us-bcast",
    "default_source": "Antenna",
    "scan_on_start": false,
    "scan_tuners_per_device": 0,
    "refresh": "10m"
  },

  "guide": {
    "refresh": "3h",
    "hold": "45s",
    "parallel": 3
  },

  "linger": "5s",
  "client_buffer_mb": 16,
  "idle_release": "60s"
}
